{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "kind": {
      "enum": [
        "geometry",
        "physics"
      ]
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "ENU"
        },
        "units": {
          "const": "m"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "height_m": {
              "type": "number"
            },
            "vertical_datum": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "longitude",
            "latitude",
            "height_m",
            "vertical_datum"
          ]
        },
        "bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "georeferenced": {
          "type": "boolean"
        }
      },
      "required": [
        "frame",
        "units",
        "origin",
        "bounds_m"
      ]
    },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "canopy-run-v1"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "format",
        "manifest",
        "sha256",
        "layers"
      ]
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "asset_id",
    "version",
    "kind",
    "spatial",
    "derived_from",
    "provenance",
    "files",
    "payload"
  ]
}
