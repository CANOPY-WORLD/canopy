{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "geometry",
        "physics"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "geometry",
              "physics"
            ]
          },
          "required_layers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "kind",
          "required_layers"
        ]
      }
    },
    "parameters": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancel": {
          "type": "boolean"
        },
        "resume": {
          "type": "boolean"
        },
        "progress": {
          "enum": [
            "steps",
            "phases"
          ]
        }
      },
      "required": [
        "cancel",
        "resume",
        "progress"
      ]
    },
    "guide": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "method_id",
    "version",
    "category",
    "title",
    "description",
    "adapter",
    "inputs",
    "parameters",
    "outputs",
    "dependencies",
    "capabilities",
    "guide",
    "example"
  ]
}
