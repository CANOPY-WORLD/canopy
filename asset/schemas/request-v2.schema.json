{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "method_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "model_id",
    "method_id",
    "method_version",
    "inputs",
    "parameters",
    "execution"
  ]
}
