{
  "schema_version": "2.0.0",
  "model_id": "flood",
  "method_id": "shallow_water",
  "version": "2.0.0",
  "category": "physics",
  "title": "NN4PDEs shallow-water flooding",
  "description": "Original AI4SWE Linear kernel from Amin-Nadimy/Shallow_Water_Equations_NN4PDEs at be4ccdac6270fb0a27a11856d4fafe44cef2ed9e, with a Canopy case driver.",
  "adapter": "nn4pdes_linear",
  "inputs": {
    "geometry": {
      "kind": "geometry",
      "required_layers": [
        "mesh"
      ],
      "required_artifacts": [
        "heightfield"
      ]
    }
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "frames": {
        "type": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 10000,
        "description": "Saved intervals after initial state",
        "x-unit": "1"
      },
      "frame_seconds": {
        "type": "number",
        "default": 1,
        "minimum": 0.001,
        "maximum": 3600,
        "description": "Physical time between saved frames",
        "x-unit": "s"
      },
      "dt_max_s": {
        "type": "number",
        "default": 0.025,
        "minimum": 1e-06,
        "maximum": 10,
        "description": "Upper bound on fixed timestep; dt = frame_seconds / ceil(frame_seconds / dt_max_s). No adaptive CFL adjustment.",
        "x-unit": "s"
      },
      "rain_mm_h": {
        "type": "number",
        "default": 20,
        "minimum": 0,
        "maximum": 1000,
        "description": "Uniform rain on non-solid cells",
        "x-unit": "mm/h"
      },
      "initial_depth_m": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 100,
        "description": "Initial water depth on non-solid terrain; building cells start dry",
        "x-unit": "m"
      },
      "manning": {
        "type": "number",
        "default": 0.055,
        "const": 0.055,
        "description": "Fixed upstream Manning roughness; other values require a separately versioned numerical change",
        "x-unit": "s/m^(1/3)"
      }
    },
    "required": [
      "frames",
      "frame_seconds",
      "dt_max_s",
      "rain_mm_h",
      "initial_depth_m",
      "manning"
    ]
  },
  "outputs": [
    "scalar_field",
    "vector_field"
  ],
  "dependencies": [
    "torch"
  ],
  "capabilities": {
    "cancel": true,
    "resume": false,
    "progress": "steps"
  },
  "guide": "model/flood/shallow_water/README.md",
  "example": "model/tests/fixtures/canopy/flood.json"
}
