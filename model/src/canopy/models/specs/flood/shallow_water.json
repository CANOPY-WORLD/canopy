{
  "schema_version": "2.0.0",
  "model_id": "flood",
  "method_id": "shallow_water",
  "version": "1.0.0",
  "category": "physics",
  "title": "Shallow-water flooding",
  "description": "Physics4D semi-implicit C-grid solver; closed boundary, explicit rainfall.",
  "adapter": "flood_swe",
  "inputs": {
    "geometry": {
      "kind": "geometry",
      "required_layers": [
        "mesh"
      ],
      "required_artifacts": [
        "heightfield"
      ]
    }
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "frames": {
        "type": "integer",
        "default": 4,
        "minimum": 1,
        "maximum": 10000,
        "description": "Saved intervals after initial state",
        "x-unit": "1"
      },
      "frame_seconds": {
        "type": "number",
        "default": 1,
        "minimum": 0.001,
        "maximum": 3600,
        "description": "Physical time between saved frames",
        "x-unit": "s"
      },
      "dt_max_s": {
        "type": "number",
        "default": 0.1,
        "minimum": 1e-06,
        "maximum": 10,
        "description": "Maximum integration step; velocity CFL may shorten it",
        "x-unit": "s"
      },
      "rain_mm_h": {
        "type": "number",
        "default": 20,
        "minimum": 0,
        "maximum": 1000,
        "description": "Uniform rain on non-solid cells",
        "x-unit": "mm/h"
      },
      "initial_depth_m": {
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 100,
        "description": "Initial water depth",
        "x-unit": "m"
      },
      "manning": {
        "type": "number",
        "default": 0.03,
        "minimum": 0,
        "maximum": 1,
        "description": "Uniform Manning roughness",
        "x-unit": "s/m^(1/3)"
      },
      "cg_max": {
        "type": "integer",
        "default": 400,
        "minimum": 1,
        "maximum": 10000,
        "description": "Surface linear-solver iteration limit",
        "x-unit": "1"
      }
    },
    "required": [
      "frames",
      "frame_seconds",
      "dt_max_s",
      "rain_mm_h",
      "initial_depth_m",
      "manning",
      "cg_max"
    ]
  },
  "outputs": [
    "scalar_field",
    "vector_field"
  ],
  "dependencies": [
    "torch"
  ],
  "capabilities": {
    "cancel": true,
    "resume": false,
    "progress": "steps"
  },
  "guide": "model/flood/shallow_water/README.md",
  "example": "model/tests/fixtures/canopy/flood.json"
}
