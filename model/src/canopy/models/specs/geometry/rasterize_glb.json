{
  "schema_version": "2.0.0",
  "model_id": "geometry",
  "method_id": "rasterize_glb",
  "version": "1.0.0",
  "category": "geometry",
  "adapter": "glb_rasterize",
  "title": "GLB to sampled heightfield",
  "description": "Rasterize transformed static GLB triangles using the Physics4D maximum-surface sampler.",
  "inputs": {
    "geometry": {
      "kind": "geometry",
      "required_layers": [
        "mesh"
      ]
    }
  },
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "layer_id": {
        "type": "string",
        "minLength": 1,
        "default": "geometry",
        "description": "Input GLB layer ID"
      },
      "bounds_xy_m": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4,
        "description": "ENU crop [west, south, east, north]; required explicit bounds",
        "x-unit": "m"
      },
      "cell_m": {
        "type": "number",
        "default": 2,
        "minimum": 0.01,
        "maximum": 1000,
        "description": "Grid spacing",
        "x-unit": "m"
      },
      "max_cells": {
        "type": "integer",
        "default": 1000000,
        "minimum": 9,
        "maximum": 16000000,
        "description": "Allocation limit; choose a small crop first",
        "x-unit": "1"
      },
      "ground_elevation_m": {
        "type": "number",
        "default": 0,
        "minimum": -10000,
        "maximum": 10000,
        "description": "Explicit flat datum in scenario ENU; exported heights are relative to it",
        "x-unit": "m"
      },
      "uncovered_ground_m": {
        "type": [
          "number",
          "null"
        ],
        "default": null,
        "minimum": -10000,
        "maximum": 10000,
        "description": "Explicit absolute ground elevation for uncovered cells; null rejects gaps",
        "x-unit": "m"
      },
      "obstacle_threshold_m": {
        "type": "number",
        "default": 0.05,
        "minimum": 0,
        "maximum": 1000,
        "description": "Height above datum considered a solid column",
        "x-unit": "m"
      }
    },
    "required": [
      "layer_id",
      "bounds_xy_m",
      "cell_m",
      "max_cells",
      "ground_elevation_m",
      "uncovered_ground_m",
      "obstacle_threshold_m"
    ]
  },
  "outputs": [
    "mesh"
  ],
  "dependencies": [],
  "capabilities": {
    "cancel": true,
    "resume": false,
    "progress": "steps"
  },
  "guide": "model/geometry/rasterize_glb/README.md",
  "example": "model/tests/fixtures/canopy/rasterize_glb.json"
}
