{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "ENU"
        },
        "units": {
          "const": "m"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "height_m": {
              "type": "number"
            },
            "vertical_datum": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "longitude",
            "latitude",
            "height_m",
            "vertical_datum"
          ]
        },
        "bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "max": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "georeferenced": {
          "type": "boolean"
        }
      },
      "required": [
        "frame",
        "units",
        "origin",
        "bounds_m"
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "2.0.0"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "model_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "method_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "method_version": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "parameters": {
            "type": "object"
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "device": {
                "enum": [
                  "cpu",
                  "cuda"
                ]
              },
              "threads": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              }
            },
            "required": []
          }
        },
        "required": [
          "schema_version",
          "scenario_id",
          "model_id",
          "method_id",
          "method_version",
          "inputs",
          "parameters",
          "execution"
        ]
      }
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "const": "standard"
        },
        "preset": {
          "enum": [
            "engineering",
            "city",
            "laboratory"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "layer": {
                "type": "string",
                "minLength": 1
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": [
              "asset",
              "layer"
            ]
          }
        },
        "time_alignment": {
          "enum": [
            "relative",
            "absolute"
          ]
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "position",
            "target"
          ]
        }
      },
      "required": [
        "template",
        "preset",
        "layers",
        "time_alignment"
      ]
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewer": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "viewer",
        "description"
      ]
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "spatial",
    "assets",
    "tasks",
    "visualization"
  ]
}
